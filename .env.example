# 复制为 .env 后修改。.env 已在 .gitignore 中，不会被提交。

DATABASE_URL=postgresql+asyncpg://grc:grc@db:5432/grc
REDIS_URL=redis://redis:6379/0

# 生产部署（docker-compose.prod.yml）才用得到：数据库容器的口令。
# **必须与上面 DATABASE_URL 里的口令一致**——一个给数据库建账号，一个给应用连。
POSTGRES_PASSWORD=
# ── 生产 HTTPS 入口（Caddy，见 OPERATIONS.md「HTTPS」）──
# 对外域名或内网主机名
SITE_ADDRESS=localhost
# internal = Caddy 自建 CA（内网）；填邮箱 = Let's Encrypt 自动证书（需公网可达）
TLS_ISSUER=internal
PROXY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# ── 定时备份与异地复制（scripts/backup.sh，见 OPERATIONS.md「Scheduled backups」）──
# 本地保留份数
BACKUP_KEEP=14
# 异地目标，二选一，留空则只做本地备份（脚本会告警）：
#   rsync: user@backup-host:/srv/grc-backups/
#   rclone: remote:bucket/grc   （需先 rclone config）
BACKUP_OFFSITE_RSYNC=
BACKUP_OFFSITE_RCLONE=

# Fernet 主密钥，用于加密数据库里存的 AI provider API key。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须换成真正的随机值：填 CHANGE_ME 或留空，进程会拒绝启动。
APP_SECRET_KEY=CHANGE_ME

# JWT 签名密钥。生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 同上，占位值会被拒绝。
JWT_SECRET=CHANGE_ME

JWT_EXPIRE_MINUTES=480

# 只有开发栈用得上：vite 开发服务器在 5173，和 api 不同源，要显式放行。
# 生产栈（docker-compose.prod.yml）不需要动这一行——nginx 把 /api 反代成同源，
# 浏览器根本不发 CORS 预检。填成生产域名也不会生效，别为此改。
CORS_ORIGINS=["http://localhost:5173"]
